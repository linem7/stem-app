# ==========================================================
# 复制这个文件为 .env，然后把每一项填上真实的值。
#   cp .env.example .env      （Windows: copy .env.example .env）
#
# .env 里有密钥，绝对不要提交到 Git、不要发给别人、不要写进前端代码。
# 没填的必填项，启动时会明确告诉你缺哪个、去哪申请。
# ==========================================================


# ---------- 【必填】数据库 ----------
# PostgreSQL 14 以上。
# 去哪弄：
#   本地开发 —— 装 PostgreSQL（见 README「第一步」），默认地址就是下面这个样子
#   线上 ——     腾讯云 / 阿里云控制台 → 云数据库 PostgreSQL → 买最小规格 → 复制连接串
# 格式：postgres://用户名:密码@主机:端口/数据库名
DATABASE_URL=postgres://postgres:你的密码@localhost:5432/stem_app

# 云数据库通常要求 SSL；本地开发一般不用。要开就填 true。
DATABASE_SSL=false


# ---------- 【必填】登录令牌签名密钥 ----------
# 用来签发老师登录后的 token。它不用去任何地方申请，你自己随便生成一串长的随机字符即可。
# 生成方法（任选其一）：
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#   或者去 https://www.random.org/strings/ 随便复制一串
# 要求：至少 32 个字符。换掉它会导致所有老师需要重新登录。
JWT_SECRET=请替换成一串你自己生成的至少32位随机字符串

# 登录有效期（秒）。默认 30 天 = 2592000，与 api-spec 的 expires_in 一致。
JWT_EXPIRES_IN=2592000


# ---------- 【必填】微信小程序 ----------
# 去哪申请：https://mp.weixin.qq.com → 注册小程序 → 左侧「开发管理」→「开发设置」
#   AppID    在「开发者ID」一栏，形如 wx1234567890abcdef
#   AppSecret 在同一栏，点「生成」后只显示一次，务必当场复制保存
# 用途：① 用 wx.login 的 code 换 openid ② 调内容安全接口 msgSecCheck
WECHAT_APPID=wx你的小程序AppID
WECHAT_SECRET=你的小程序AppSecret

# 内容安全检查开关。
# 微信规定：小程序有用户生成内容（UGC）必须过 msgSecCheck，否则审核不通过。
# 本地开发没有真实 openid 时可以设 false 先跑通流程；正式上线必须 true。
CONTENT_CHECK_ENABLED=false


# ---------- 【必填】DeepSeek 文本模型 ----------
# 去哪申请：https://platform.deepseek.com → 注册 → 左侧「API keys」→ 创建
#   注意：要先在「充值」页充一点钱（十几块够内测跑很久），否则调用会报余额不足
# key 形如 sk-xxxxxxxxxxxxxxxx。这个 key 只留在服务器上，任何情况下都不下发给小程序。
DEEPSEEK_API_KEY=sk-你的DeepSeekKey

# 一般不用改。DeepSeek 兼容 OpenAI 协议，所以用官方 openai 包换个 baseURL 就能用。
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 单次调用超时（毫秒）。生成整份教案比出题慢，所以生成那一步代码里会单独放宽。
DEEPSEEK_TIMEOUT_MS=60000
# 失败重试次数（只对超时/限流/5xx 重试，参数错误不重试）
DEEPSEEK_MAX_RETRIES=2


# ---------- 【选填】MiniMax 图片模型 ----------
# 不填 = 配图功能关闭，其余功能全部正常，可以先把主流程跑通再回来配。
# 去哪申请：https://platform.minimaxi.com → 注册 → 账户管理 → 接口密钥 → 新建
#   注意：要先充值，否则调用会返回「insufficient balance」
# 2026-08-17 从字节豆包换过来：豆包走火山引擎签名机制 V4，要自己实现 HMAC 四步派生，
# 调不通几乎没法排查；MiniMax 一个 Bearer token 加一次 POST，当场能用 curl 验证。
MINIMAX_API_KEY=
# 大陆用 api.minimaxi.com，海外是 api.minimax.io。老师都在大陆，别改。
MINIMAX_BASE_URL=https://api.minimaxi.com
MINIMAX_MODEL=image-01
MINIMAX_TIMEOUT_MS=60000
# 每人每天最多生成几张图。图片是最大成本项（约 2.5 分/张），这个闸门不能去掉（api-spec 第 6 节）。
IMAGE_DAILY_LIMIT=10


# ---------- 【选填】对象存储（存配图和导出的 Word）----------
# 不填 = 图片和导出功能会明确报「未配置对象存储」，不会静默失败。
# 去哪申请：腾讯云 COS（https://console.cloud.tencent.com/cos）
#           或阿里云 OSS（https://oss.console.aliyun.com）
#   建一个存储桶（Bucket）→ 权限设为公有读私有写 → 复制访问域名
OBJECT_STORAGE_BASE_URL=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_KEY_ID=
OBJECT_STORAGE_KEY_SECRET=


# ---------- 【必填】管理后台 ----------
# 电脑浏览器访问 /admin，用来发兑换码、发额度、看用量和反馈。
# 只有这一个账号，没有第二个 —— 这是「园方看不到老师数据」那句承诺的技术兑现：
# 系统里根本不存在「园所管理员」这种角色。
# 密码自己起一个长的，和数据库密码不要一样。
ADMIN_PASSWORD=请设一个至少16位的强密码


# ---------- 【选填】服务运行参数 ----------
PORT=3000
# development | production。production 下会关掉开发用的假登录。
NODE_ENV=development
# debug | info | warn | error
LOG_LEVEL=info

# 开发用假登录开关。
# 打开后可以用 code = "dev:任意字符串" 直接换到 token，不需要真的小程序。
# 这是为了让你在还没申请到微信 AppID 时就能用 curl 把后端跑通。
# NODE_ENV=production 时这个开关会被强制忽略。
DEV_FAKE_LOGIN=true

# 没配上面的对象存储时，配图存到这个本地目录，由 /local-images 静态路由提供访问。
# 只在单机开发时成立，正式部署必须配 OBJECT_STORAGE_*。
LOCAL_IMAGE_DIR=./.local-images
# 拼本地图片 URL 用，部署到公网后改成真实域名（如 https://api.你的域名.com）
PUBLIC_BASE_URL=http://localhost:3000

# 进程内任务队列的并发数（教案生成、配图）。
# 单台 2 核 4G 服务器建议 2；调大只会让每个任务都变慢，因为瓶颈在模型接口不在 CPU。
TASK_CONCURRENCY=2

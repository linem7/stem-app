# ==========================================================
# 复制这个文件为 .env，然后把每一项填上真实的值。
#   cp .env.example .env      （Windows: copy .env.example .env）
#
# .env 里有密钥，绝对不要提交到 Git、不要发给别人、不要写进前端代码。
# 没填的必填项，启动时会明确告诉你缺哪个、去哪申请。
# ==========================================================


# ---------- 【必填】数据库 ----------
# PostgreSQL 14 以上。
# 去哪弄：
#   本地开发 —— 装 PostgreSQL（见 README「第一步」），默认地址就是下面这个样子
#   线上 ——     **不买云数据库**。在阿里云服务器上自己装 PostgreSQL，
#               所以线上这一串也是 localhost（ADR-003）。买 RDS 是另一份月费，
#               而内测规模（库十几 MB、几十位老师）用不上它
# 格式：postgres://用户名:密码@主机:端口/数据库名
DATABASE_URL=postgres://postgres:你的密码@localhost:5432/stem_app

# 走 localhost 连本机的 PG 不需要 SSL。哪天真换成云数据库（它通常强制 SSL）再改 true。
DATABASE_SSL=false


# ---------- 【必填】登录令牌签名密钥 ----------
# 用来签发老师登录后的 token。它不用去任何地方申请，你自己随便生成一串长的随机字符即可。
# 生成方法（任选其一）：
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#   或者去 https://www.random.org/strings/ 随便复制一串
# 要求：至少 32 个字符。换掉它会导致所有老师需要重新登录。
JWT_SECRET=请替换成一串你自己生成的至少32位随机字符串

# 登录有效期（秒）。默认 30 天 = 2592000，与 api-spec 的 expires_in 一致。
JWT_EXPIRES_IN=2592000


# ---------- 【必填，但已作废】微信小程序 ----------
# 🔴 **不要真去注册小程序。** 2026-08-30 已经转向 web 端
#    （docs/adr/ADR-002-pivot-to-web.md），微信那条路整条作废，
#    转向的理由是甩掉「借企业主体」。
#
# 那为什么还留着？因为代码还没拆干净：services/wechat.js 仍被 9 个 route 文件
# import，启动自检（src/config.js）也还拦着这两个变量 —— 缺了直接退出。
# 所以现在**必须填，填占位值即可**：
WECHAT_APPID=wx_placeholder
WECHAT_SECRET=placeholder

# 内容安全检查开关。
# 🔴 现在开了也没用：它开的是**微信的** msgSecCheck，而 web 端不走微信。
#    真正要接的是阿里云内容安全（TextModerationPlus），还没写
#    —— services/contentSafety.js 那一项在待办里。
# ⚠️ 上线前必须有内容安全，这是使用协议里对老师的承诺。
CONTENT_CHECK_ENABLED=false


# ---------- 【首次启动必填】DeepSeek 文本模型 ----------
# 去哪申请：https://platform.deepseek.com → 注册 → 左侧「API keys」→ 创建
#   注意：要先在「充值」页充一点钱（十几块够内测跑很久），否则调用会报余额不足
# key 形如 sk-xxxxxxxxxxxxxxxx。这个 key 只留在服务器上，任何情况下都不下发到浏览器。
#
# ⚠️ 这一段只在**第一次启动**时起作用：启动时会把它一次性搬进数据库（ai_models 表），
#    之后改这里不再生效 —— 换模型、改地址、开思考模式，一律在管理后台的「模型管理」里改。
DEEPSEEK_API_KEY=sk-你的DeepSeekKey

# 一般不用改。DeepSeek 兼容 OpenAI 协议，所以用官方 openai 包换个 baseURL 就能用。
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# 单次调用超时（毫秒）。生成整份教案比出题慢，所以生成那一步代码里会单独放宽。
DEEPSEEK_TIMEOUT_MS=60000
# 失败重试次数（只对超时/限流/5xx 重试，参数错误不重试）
DEEPSEEK_MAX_RETRIES=2


# ---------- 【选填】MiniMax 图片模型 ----------
# 不填 = 配图功能关闭，其余功能全部正常，可以先把主流程跑通再回来配。
# 去哪申请：https://platform.minimaxi.com → 注册 → 账户管理 → 接口密钥 → 新建
#   注意：要先充值，否则调用会返回「insufficient balance」
# 2026-08-17 从字节豆包换过来：豆包走火山引擎签名机制 V4，要自己实现 HMAC 四步派生，
# 调不通几乎没法排查；MiniMax 一个 Bearer token 加一次 POST，当场能用 curl 验证。
MINIMAX_API_KEY=
# 大陆用 api.minimaxi.com，海外是 api.minimax.io。老师都在大陆，别改。
MINIMAX_BASE_URL=https://api.minimaxi.com
MINIMAX_MODEL=image-01
MINIMAX_TIMEOUT_MS=120000
# 每人每天最多生成几张图。图片是最大成本项（约 2.5 分/张），这个闸门不能去掉（api-spec 第 6 节）。
IMAGE_DAILY_LIMIT=10


# ---------- 【选填】阿里云 RAM 用户 AccessKey（部署用）----------
# 变量名是阿里云 SDK 默认读取的名字，不要改。
# 去哪申请：RAM 控制台（https://ram.console.aliyun.com）→ 建 RAM 用户 → 只给部署要的权限
# 不要用云账号（主账号）的 AccessKey：它有全部权限，且没法收窄。
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=


# ---------- 【选填】对象存储（存配图和导出的 Word）----------
# 不填 = 图片和导出功能会明确报「未配置对象存储」，不会静默失败。
# 去哪申请：阿里云 OSS（https://oss.console.aliyun.com）—— 跟服务器同一家（ADR-003）
#   建一个存储桶（Bucket）→ 权限设为公有读私有写 → 复制访问域名
# ⚠️ 变量名保留 OBJECT_STORAGE_* 这个中性叫法，**不要改成 OSS_***：
#    换一家对象存储时只改值不改代码。
OBJECT_STORAGE_BASE_URL=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_KEY_ID=
OBJECT_STORAGE_KEY_SECRET=


# ---------- 【必填】管理后台 ----------
# 电脑浏览器访问 /admin，用来发兑换码、发额度、看用量和反馈。
# 只有这一个账号，没有第二个 —— 这是「园方看不到老师数据」那句承诺的技术兑现：
# 系统里根本不存在「园所管理员」这种角色。
# 密码自己起一个长的，和数据库密码不要一样。
ADMIN_PASSWORD=请设一个至少16位的强密码


# ---------- 【选填】服务运行参数 ----------
PORT=3000
# development | production。production 下会关掉开发用的假登录。
NODE_ENV=development
# debug | info | warn | error
LOG_LEVEL=info

# 开发用假登录开关。
# 打开后可以用 code = "dev:任意字符串" 直接换到 token，不需要真的登录。
# 新身份模型（手机号 + 密码）还没做，本地开发和前端 dev:account 都靠它顶着。
# NODE_ENV=production 时这个开关会被强制忽略。
DEV_FAKE_LOGIN=true

# 没配上面的对象存储时，配图存到这个本地目录，由 /local-images 静态路由提供访问。
# 只在单机开发时成立，正式部署必须配 OBJECT_STORAGE_*。
LOCAL_IMAGE_DIR=./.local-images
# 拼本地图片 URL 用，部署到公网后改成真实域名（如 https://api.你的域名.com）
PUBLIC_BASE_URL=http://localhost:3000

# 进程内任务队列的并发数（教案生成、配图）。
# 单台 2 核 4G 服务器建议 2；调大只会让每个任务都变慢，因为瓶颈在模型接口不在 CPU。
TASK_CONCURRENCY=2

# ---- 配图模型 ----
# 默认用哪家：gpt（gpt-image-2，表格线条准）| minimax（插画更活泼）。
# 只是兜底：后台「模型管理」里「设为默认」设过之后，以库里的为准。老师那边没有任何模型选项
IMAGE_PROVIDER=gpt
# 文本默认用哪家，同上只是兜底。一般不用改
TEXT_PROVIDER=deepseek
# gpt-image-2，经 12ai 中转。注意 IMG_BASE_URL 已经带 /v1，代码只拼 /images/generations
IMG_API_KEY=sk-REPLACE_ME
IMG_BASE_URL=https://cdn.12ai.org/v1
IMG_MODEL=gpt-image-2
# low | medium | high | auto。medium 实测就能画对记录表的格子
IMG_QUALITY=medium
# 实测 medium+1536x2048 要 71 秒，比 MiniMax 还慢，别照抄 60000
IMG_TIMEOUT_MS=150000

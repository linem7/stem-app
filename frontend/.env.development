# 本地开发。vite dev server 把 /v1 代理给 localhost:3000（见 vite.config.js）。
VITE_API_BASE=/v1

# 网页端的登录（手机号 + 密码）后端还没做，本地开发拿后端的 DEV_FAKE_LOGIN 顶着。
# 后端那边 backend/.env 里也要有 DEV_FAKE_LOGIN=true。
VITE_DEV_FAKE_LOGIN=true

# 假登录用哪个身份由 `npm run dev:account` 写进 .env.development.local（本机文件，不进 git）——
# 那个值每台机器不一样，提交进来会让下一个人拿到一个指向不存在账号的配置。

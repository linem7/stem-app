{
  "name": "幼儿园STEAM教案",
  "appid": "",
  "description": "帮幼儿园老师撰写 STEAM 教案",
  "versionName": "0.1.0",
  "versionCode": "100",
  "transformPx": false,
  "vueVersion": "3",
  "mp-weixin": {
    // 2026-08-25 填上真 AppID。在这之前是空的，微信开发者工具会用「测试号」打开 ——
    // 够本地开发，但 wx.login 拿不到真 code、msgSecCheck 也调不通。
    // ⚠️ 改这里之后必须重跑 dev:mp-weixin：appid 是编译时写进 dist 的 project.config.json 的，
    //    watch 模式不一定会重读 manifest.json。
    "appid": "wxd7ae717c264d181e",
    "setting": {
      // 本地后端是 http://localhost:3000，没有 https 域名，必须关掉域名校验。
      // 开发者工具里「不校验合法域名」那个勾也要同时打上。
      "urlCheck": false,
      "es6": true,
      "minified": true,
      "postcss": true
    },
    "usingComponents": true,
    // 按需注入（2026-08-25，上传版本时微信强制要求的性能项）：
    // 只注入当前页面用到的组件代码，不是打包体积优化，是启动耗时优化。
    // 编译时会原样写进 dist 的 app.json。
    "lazyCodeLoading": "requiredComponents",
    "permission": {
      // 配图要存到相册给老师拿去打印。第一次保存会弹这句授权说明
      "scope.writePhotosAlbum": {
        "desc": "把活动配图存到你的相册，方便打印出来在活动里用"
      }
    },
    "requiredPrivateInfos": []
  },
  "h5": {
    // H5 只用来在电脑浏览器里快速看布局，不是交付目标。
    "title": "幼儿园STEAM教案",
    "router": { "mode": "hash" }
  },
  "uniStatistics": {
    "enable": false
  }
}
